{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Diff": {
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Manifest": {
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "command",
        "capabilities"
      ]
    }
  },
  "properties": {
    "color": {
      "type": "string",
      "enum": [
        "auto",
        "always",
        "never"
      ]
    },
    "diff": {
      "$ref": "#/$defs/Diff"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/Manifest"
      },
      "type": "object"
    },
    "sources": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "Traces configuration"
}
