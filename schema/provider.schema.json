{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "properties": {
        "description": {
          "type": "string"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "description"
      ]
    },
    "Defaults": {
      "properties": {
        "timeout": {
          "$ref": "#/$defs/Duration"
        },
        "priority": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
      "description": "Go duration such as 500ms, 10s, or 2m"
    },
    "Requirements": {
      "properties": {
        "commands": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "environment": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "provider/v1"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "description": {
      "type": "string"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "minItems": 1
    },
    "actions": {
      "additionalProperties": {
        "$ref": "#/$defs/Action"
      },
      "type": "object"
    },
    "requires": {
      "$ref": "#/$defs/Requirements"
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "name",
    "description",
    "command",
    "actions"
  ],
  "title": "External provider manifest"
}
