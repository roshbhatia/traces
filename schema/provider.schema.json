{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "description"
      ],
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "priority": {
          "type": "integer"
        },
        "timeout": {
          "$ref": "#/$defs/Duration"
        }
      },
      "type": "object"
    },
    "Duration": {
      "description": "Go duration such as 500ms, 10s, or 2m",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
      "type": "string"
    },
    "Requirements": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "environment": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "additionalProperties": {
        "$ref": "#/$defs/Action"
      },
      "propertyNames": {
        "enum": [
          "activity.read",
          "diff.render",
          "session.current",
          "session.discover"
        ]
      },
      "type": "object"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "description": {
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9._-]*$",
      "type": "string"
    },
    "requires": {
      "$ref": "#/$defs/Requirements"
    },
    "version": {
      "enum": [
        "provider/v1"
      ],
      "type": "string"
    }
  },
  "required": [
    "version",
    "name",
    "description",
    "command",
    "actions"
  ],
  "title": "External provider manifest",
  "type": "object"
}
